  { id:21, name:'ElevenLabs', category:'Audio & Speech', company:'ElevenLabs', pricing:'Freemium', api:true, score:92, strengths:['Voice quality','Cloning','Real-time'] },
  { id:22, name:'DeepL', category:'Translation', company:'DeepL', pricing:'Freemium', api:true, score:91, strengths:['Quality','Context-aware','Speed'] },
