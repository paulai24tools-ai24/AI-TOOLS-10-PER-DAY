const RESEARCH_FRAMEWORK = {
  'Research Objectives': ['Map complete AI ecosystem','Identify tool strengths/weaknesses','Find market gaps and opportunities','Build personal AI stack recommendations'],
  'Evaluation Criteria': ['Accuracy & reliability','Ease of use','Pricing value','API capability','Integration ecosystem','Community support','Security & privacy','Performance & speed'],
  'Scope': ['Foundation models to consumer applications','Open source and commercial tools','APIs and integrations','Enterprise and personal solutions'],
  'Methodology': ['Official documentation analysis','Product testing and review','Competitive intelligence','Community and GitHub analysis','Academic and industry research']
};

const STACKS = [
  { name:'Solo Founder Stack', desc:'Complete toolkit for one-person operations', tools:['Claude 3.5','Cursor','Perplexity AI','DALL-E 3'] },
  { name:'Content Creator Stack', desc:'Written, visual, and audio content at scale', tools:['Claude 3.5','Runway ML','DALL-E 3','ElevenLabs'] },
  { name:'Developer Stack', desc:'Full-stack development acceleration', tools:['Cursor','Claude Code','GitHub Copilot','v0 by Vercel'] },
  { name:'Research Stack', desc:'Comprehensive research and analysis framework', tools:['Perplexity AI','Claude 3.5','DeepL'] },
  { name:'Design Stack', desc:'From concept to production design workflow', tools:['Adobe Firefly','DALL-E 3','Claude 3.5','v0 by Vercel'] },
  { name:'Marketing Stack', desc:'End-to-end marketing automation and content', tools:['Claude 3.5','DALL-E 3','ElevenLabs','Perplexity AI'] },
