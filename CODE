const OPPORTUNITIES = [
  { title:'AI-Powered CRM for SMBs', gap:'HubSpot/Salesforce too expensive for small businesses', market:'$5B', difficulty:'Medium', score:92 },
  { title:'Vertical SaaS for Legal', gap:'Legal industry needs specialized AI tools', market:'$2B+', difficulty:'High', score:88 },
  { title:'AI Agent Marketplace', gap:'No easy way to discover and deploy pre-built agents', market:'$10B+', difficulty:'Medium', score:90 },
  { title:'Local Business AI Assistant', gap:"Small shops need affordable AI but don't know how to use it", market:'$3B', difficulty:'Low', score:85 },
  { title:'AI Data Quality Platform', gap:'Training data quality is a massive bottleneck', market:'$4B', difficulty:'High', score:89 },
];

const TRENDS = {
  '6 Months': ['GPT-5 rumors','Multimodal improvements','Better reasoning','Open source competition'],
  '1 Year': ['Specialized AI','Real-time integration','Agentic workflows','Edge AI adoption'],
  '3 Years': ['AI agents','Autonomous coding','Multimodal standard','Enterprise AI'],
  '5 Years': ['Task automation','General-purpose agents','Hardware acceleration','AI literacy skills'],
};

const RECOMMENDATIONS = [
  { title:'Primary Stack', icon:'⭐', color:'var(--orange)', tools:['Claude 3.5','Cursor','Perplexity AI','DALL-E 3'] },
  { title:'Coding Stack', icon:'💻', color:'var(--blue)', tools:['Cursor','Claude Code','GitHub Copilot'] },
  { title:'Research Stack', icon:'🔍', color:'var(--green)', tools:['Perplexity AI','Claude 3.5','DeepL'] },
  { title:'Creation Stack', icon:'🎨', color:'var(--orange)', tools:['DALL-E 3','Runway ML','ElevenLabs'] },
];

const PHASES = [
  { id:'phase0', label:'Foundation', icon:'🧠' },
  { id:'phase2', label:'Tools', icon:'📊' },
  { id:'phase4', label:'Compare', icon:'⚖️' },
  { id:'phase5', label:'Stacks', icon:'🔗' },
  { id:'phase6', label:'Opportunities', icon:'💡' },
  { id:'phase9', label:'Future', icon:'🔮' },
  { id:'phase10', label:'Recommend', icon:'⭐' },
];

/* =========================================================
   STATE
   ========================================================= */
let favorites = new Set();
let comparison = [];
let currentPhase = 'hero';

/* =========================================================
   RENDER: static sections (built once)
   ========================================================= */
function buildStaticContent(){
  // Hero dots
  document.getElementById('heroDots').innerHTML = PHASES.map(p =>
    `<button class="phase-dot" onclick="goPhase('${p.id}')">${p.icon} ${p.label}</button>`
  ).join('');

  // Header phase nav
  document.getElementById('phaseNav').innerHTML = PHASES.map(p =>
    `<button class="phase-btn" data-phase="${p.id}" onclick="goPhase('${p.id}')">${p.icon} ${p.label}</button>`
  ).join('');

  // Category select
  const categories = ['All', ...new Set(TOOLS.map(t => t.category))];
  document.getElementById('categorySelect').innerHTML = categories.map(c => `<option value="${c}">${c}</option>`).join('');

  // Phase 0
  document.getElementById('phase0Grid').innerHTML = Object.entries(RESEARCH_FRAMEWORK).map(([title, items]) => `
    <div class="card">
      <h3 style="color:var(--orange); margin-bottom:14px;">${title}</h3>
      <ul>${items.map(i => `<li><span class="arrow">→</span>${i}</li>`).join('')}</ul>
    </div>
  `).join('');

  // Phase 5
  document.getElementById('stacksGrid').innerHTML = STACKS.map(s => `
    <div class="card">
      <h3 style="color:var(--green); margin-bottom:4px;">${s.name}</h3>
      <p class="muted small" style="margin-bottom:14px;">${s.desc}</p>
      <ul>${s.tools.map(t => `<li><span class="arrow" style="color:var(--green)">→</span>${t}</li>`).join('')}</ul>
    </div>
  `).join('');

  // Phase 6
  document.getElementById('oppList').innerHTML = OPPORTUNITIES.map(o => `
    <div class="opp-row">
      <div>
        <h3>${o.title}</h3>
        <p class="muted small" style="margin-top:6px;">${o.gap}</p>
      </div>
      <div><div class="stat-label">Market</div><div class="stat-val">${o.market}</div></div>
      <div><div class="stat-label">Difficulty</div><div class="stat-val">${o.difficulty}</div></div>
      <div class="opp-score"><div class="num">${o.score}</div><div class="lbl">opportunity score</div></div>
    </div>
  `).join('');

  // Phase 9
  document.getElementById('trendsGrid').innerHTML = Object.entries(TRENDS).map(([period, items]) => `
    <div class="card">
      <h3 style="color:var(--blue); margin-bottom:14px;">${period}</h3>
      <ul>${items.map(i => `<li><span class="arrow" style="color:var(--blue)">•</span>${i}</li>`).join('')}</ul>
    </div>
  `).join('');

  // Phase 10
  document.getElementById('recsGrid').innerHTML = RECOMMENDATIONS.map(r => `
    <div class="card">
      <h3 style="color:${r.color}; margin-bottom:14px;">${r.icon} ${r.title}</h3>
      <ul>${r.tools.map(t => `<li><span class="arrow" style="color:${r.color}">•</span>${t}</li>`).join('')}</ul>
    </div>
  `).join('');
}

/* =========================================================
   RENDER: dynamic tool grid (Phase 2)
   ========================================================= */
function renderTools(){
  const search = (document.getElementById('searchInput')?.value || '').toLowerCase();
  const cat = document.getElementById('categorySelect')?.value || 'All';
  const filtered = TOOLS.filter(t =>
    t.name.toLowerCase().includes(search) && (cat === 'All' || t.category === cat)
  );

  document.getElementById('resultsCount').textContent = `Showing ${filtered.length} of ${TOOLS.length} tools`;

  document.getElementById('toolsGrid').innerHTML = filtered.map(t => {
    const isFav = favorites.has(t.id);
    const inCmp = comparison.find(c => c.id === t.id);
    return `
    <div class="card tool-card">
      <div class="tool-head">
        <div>
          <h3>${t.name}</h3>
          <p class="muted small">${t.company}</p>
        </div>
        <button class="fav-btn ${isFav ? 'active' : ''}" onclick="toggleFav(${t.id})" aria-label="Favorite ${t.name}">★</button>
      </div>
      <div class="kv"><span>Category</span><span style="color:var(--blue)">${t.category}</span></div>
      <div class="kv"><span>Pricing</span><span style="color:var(--green)">${t.pricing}</span></div>
      <div class="kv"><span>Score</span><span class="score">${t.score}/100</span></div>
      <div class="tags">${t.strengths.map(s => `<span class="tag">${s}</span>`).join('')}</div>
      <button class="cmp-btn" ${inCmp ? 'disabled' : ''} onclick="addToComparison(${t.id})">
        ${inCmp ? 'Added to compare' : 'Add to compare'}
      </button>
    </div>`;
  }).join('') || `<div class="empty">No tools match your search.</div>`;
}

function toggleFav(id){
  favorites.has(id) ? favorites.delete(id) : favorites.add(id);
  renderTools();
}

/* =========================================================
   COMPARISON (Phase 4)
   ========================================================= */
function addToComparison(id){
  if (comparison.length >= 4 || comparison.find(t => t.id === id)) return;
  comparison.push(TOOLS.find(t => t.id === id));
  updateCompareUI();
  renderTools();
}
function removeFromComparison(id){
  comparison = comparison.filter(t => t.id !== id);
  updateCompareUI();
  renderTools();
}
function updateCompareUI(){
  document.getElementById('cmpCount').textContent = comparison.length;
  document.getElementById('compareToggle').style.display = comparison.length ? 'inline-flex' : 'none';
  renderComparisonArea();
}
function renderComparisonArea(){
  const area = document.getElementById('comparisonArea');
  if (!comparison.length){
    area.innerHTML = `<div class="empty">Select up to 4 tools from the Tools tab to compare them here.</div>`;
    return;
  }
  const rows = [
    ['Company', t => t.company],
    ['Category', t => t.category],
    ['Pricing', t => t.pricing],
    ['API Available', t => t.api ? '✓ Yes' : '✗ No'],
    ['Overall Score', t => `${t.score}/100`],
  ];
  area.innerHTML = `
    <div class="cmp-wrap">
      <table>
        <thead><tr><th>Criteria</th>${comparison.map(t => `<th>${t.name}</th>`).join('')}</tr></thead>
        <tbody>
          ${rows.map(([label, fn]) => `
            <tr><td style="font-weight:600">${label}</td>${comparison.map(t => `<td>${fn(t)}</td>`).join('')}</tr>
          `).join('')}
        </tbody>
      </table>
    </div>
    <div class="cmp-chips">
      ${comparison.map(t => `<div class="chip">${t.name}<button onclick="removeFromComparison(${t.id})" aria-label="Remove ${t.name}">✕</button></div>`).join('')}
    </div>
  `;
}
function toggleComparisonView(){ goPhase('phase4'); }

/* =========================================================
   NAVIGATION
   ========================================================= */
function goPhase(id){
  currentPhase = id;
  const hero = document.getElementById('hero');
  const header = document.getElementById('siteHeader');

  if (id === 'hero'){
    hero.style.display = 'flex';
    header.classList.remove('show');
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    window.scrollTo({ top:0, behavior:'smooth' });
    return;
  }

  hero.style.display = 'none';
  header.classList.add('show');
  document.querySelectorAll('.section').forEach(s => s.classList.toggle('active', s.id === id));
  document.querySelectorAll('.phase-btn').forEach(b => b.classList.toggle('active', b.dataset.phase === id));
  window.scrollTo({ top:0, behavior:'smooth' });
}

/* =========================================================
   INIT
   ========================================================= */
buildStaticContent();
renderTools();
updateCompareUI();
</script>
</body>
</html>
